# Auto load scripting addition (for this to work the command 'yabai --load-sa' should run without sudo and password)
# More details: https://github.com/koekeishiya/yabai/wiki/Installing-yabai-(latest-release)#configure-scripting-addition
yabai -m signal --add event=dock_did_restart action="sudo yabai --load-sa"
sudo yabai --load-sa

yabai -m config layout bsp
yabai -m config window_placement second_child

yabai -m config top_padding 4
yabai -m config bottom_padding 4
yabai -m config left_padding 4
yabai -m config right_padding 4
yabai -m config window_gap 4

yabai -m config --space 5 layout float
yabai -m config --space 6 layout float
yabai -m config --space 7 layout float
yabai -m config --space 8 layout float

# yabai -m config mouse_follows_focus on
yabai -m config mouse_modifier cmd
yabai -m config mouse_action1 move
yabai -m config mouse_action2 resize

yabai -m config window_border off

yabai -m config window_shadow float

yabai -m mouse_drop_action swap

yabai -m rule --add app="^System Settings$" manage=off sub-layer=below
yabai -m rule --add app="^Telegram$" float=on
# yabai -m rule --add app="^Yandex Music$" float=on
yabai -m rule --add app="^Find My$" float=on
yabai -m rule --add app="^Outline$" float=on
yabai -m rule --add app="^Photo Booth$" float=on
yabai -m rule --add app="^Weather$" float=on
yabai -m rule --add app="^Preview$" float=on
yabai -m rule --add app="^Finder$" float=on
yabai -m rule --add app="^App Store$" float=on

# Make Teams overlay appear on all spaces
# yabai -m rule --add app="^Microsoft Teams$" title="^$" manage=off sticky=on layer=above

